rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function bossDoc() { return /databases/$(database)/documents/config/boss; }
    function isBoss() {
      return signedIn() && exists(bossDoc()) && get(bossDoc()).data.uid == request.auth.uid;
    }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // Who the boss is. The first Google sign-in claims it once; after that only the boss can change it.
    match /config/boss {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isBoss();
    }

    // Christmas manito. Secrets are keyed on the participant's own sign-in (made with their 4-digit PIN).
    function mState() { return get(/databases/$(database)/documents/config/manito).data; }
    function mPhase() { return exists(/databases/$(database)/documents/config/manito) ? mState().phase : ''; }
    function mPlayerUid(m) { return get(/databases/$(database)/documents/manitoPlayers/$(m)).data.uid; }
    function mEmail(m) { return m + '-' + string(mState().resets.get(m, 0)) + '@manito.bulfist.app'; }
    function ownsEmail(e) {
      return request.auth.token.email == e
        || e in request.auth.token.firebase.identities.get('email', []);
    }
    match /config/manito {
      allow read: if true;
      allow write: if isBoss();
      // a participant's own draw: removes exactly their drawn target from `left` and adds themselves to `drawn`
      allow update: if signedIn() && resource.data.phase == 'draw'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['left', 'drawn'])
        && request.resource.data.drawn.size() == resource.data.drawn.size() + 1
        && request.resource.data.left.size() == resource.data.left.size() - 1
        && mPlayerUid(request.resource.data.drawn[request.resource.data.drawn.size() - 1]) == request.auth.uid
        && getAfter(/databases/$(database)/documents/manitoSecret/$(request.resource.data.drawn[request.resource.data.drawn.size() - 1])).data.target in resource.data.left
        && !(getAfter(/databases/$(database)/documents/manitoSecret/$(request.resource.data.drawn[request.resource.data.drawn.size() - 1])).data.target in request.resource.data.left);
    }
    match /manitoPlayers/{m} {
      allow read: if true;
      allow create: if signedIn() && mPhase() == 'signup'
        && request.resource.data.uid == request.auth.uid && ownsEmail(mEmail(m));
      allow delete: if isBoss() && mPhase() == 'signup';
    }
    match /manitoSecret/{m} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || mPhase() == 'revealed');
      allow create: if signedIn() && mPhase() == 'draw' && mPlayerUid(m) == request.auth.uid
        && request.resource.data.uid == request.auth.uid && request.resource.data.target != m;
    }
    match /manitoGuess/{m} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || mPhase() == 'revealed');
      allow write: if signedIn() && mPhase() == 'draw' && mPlayerUid(m) == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }
    match /manitoPraise/{id} {
      // only the writer before the reveal; the writer and the person praised after it. Nobody else, the boss included.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid
        || (mPhase() == 'revealed' && resource.data.toUid == request.auth.uid));
      allow create: if signedIn() && mPhase() == 'draw'
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/manitoSecret/$(request.resource.data.from)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/manitoSecret/$(request.resource.data.from)).data.target == request.resource.data.to
        && mPlayerUid(request.resource.data.to) == request.resource.data.toUid
        && shortText(request.resource.data.text, 200)
        && request.resource.data.date is string;
      allow update: if signedIn() && mPhase() == 'draw' && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'date', 'updatedAt'])
        && shortText(request.resource.data.text, 200);
      allow delete: if signedIn() && mPhase() == 'draw' && resource.data.uid == request.auth.uid;
    }

    // Other settings (e.g. the sketch game's surprise names): only the boss writes.
    match /config/{docId} {
      allow read: if true;
      allow write: if docId != 'boss' && isBoss();
    }

    // Wanted posters and custom liar topics: everyone reads, only the boss writes.
    match /members/{id} {
      allow read: if true;
      allow write: if isBoss();
    }
    // Case log, screenshots and gatherings: everyone reads, only the boss writes.
    // Case log: any member can post a case; the writer and the boss can edit or delete it.
    function validCase() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'date', 'desc', 'members', 'charges', 'hasShot', 'updatedAt', 'createdAt', 'authorUid', 'authorId', 'authorNick'])
        && shortText(d.title, 80) && d.date is string && d.date.size() == 10
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 1000))
        && d.members is list && d.members.size() <= 40 && d.charges is list && d.charges.size() <= 80;
    }
    match /incidents/{id} {
      allow read: if true;
      allow write: if isBoss();
      allow create: if signedIn() && validCase() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid && validCase();
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      // comments: everyone signed in writes under their own sign-in; they or the boss can delete
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'memberId', 'nick', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && shortText(request.resource.data.text, 300)
          && shortText(request.resource.data.nick, 30);
        allow delete: if isBoss() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
    match /incidentShots/{id} {
      allow read: if true;
      allow write: if isBoss();
      allow create, update: if signedIn()
        && getAfter(/databases/$(database)/documents/incidents/$(id)).data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string;
      allow delete: if signedIn() && get(/databases/$(database)/documents/incidents/$(id)).data.authorUid == request.auth.uid;
    }
    match /gatherings/{id} {
      allow read: if true;
      allow write: if isBoss();
    }
    // Anonymous tips: no author is stored; only published tips are readable by everyone.
    match /tips/{id} {
      allow read: if resource.data.public == true || isBoss();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'public', 'createdAt'])
        && request.resource.data.public == false
        && shortText(request.resource.data.text, 300);
      allow update, delete: if isBoss();
      // anonymous comments on published tips: no name or account is stored, so only the boss can delete them
      match /comments/{cid} {
        allow read: if get(/databases/$(database)/documents/tips/$(id)).data.public == true || isBoss();
        allow create: if signedIn()
          && get(/databases/$(database)/documents/tips/$(id)).data.public == true
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && shortText(request.resource.data.text, 300);
        allow delete: if isBoss();
      }
    }
    match /liarTopics/{id} {
      allow read: if true;
      allow write: if isBoss();
    }

    // Guestbook: anyone signed in (including the automatic guest sign-in) writes their own entry.
    match /guestbook/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.text, 300)
        && shortText(request.resource.data.nick, 30);
      allow delete: if isBoss() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Who is online in the game center: each phone writes only its own heartbeat.
    match /presence/{mid} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'm', 't', 'room', 'game', 'playing'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.m == mid;
    }

    // Liar game rooms and their chat.
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isBoss();
      match /strokes/{strokeId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.pts is list
          && request.resource.data.pts.size() <= 1200;
        allow delete: if isBoss();
      }
      match /live/{liveId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isBoss();
      }
      match /msgs/{msgId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && shortText(request.resource.data.text, 200);
        allow delete: if isBoss();
      }
    }
  }
}
